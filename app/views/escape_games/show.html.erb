<section>
  <div>
    <h1><%= @escape_game.title %></h1>
    <p>
      <%= @escape_game.description %>
    </p>
    <img class="eg_photo" <%= image_tag @escape_game.image_file_name %>
    <table>
      <tr>
        <th>Difficulty:</th>
        <td><%= @escape_game.difficulty %>/5</td>
      </tr>
    </table>
  </div>
</section>

<section class="show_content">
  <div>
    <%= form_with url: check_answers_escape_game_path(@escape_game), method: :post do |form| %>
      <h2>Questions</h2>
      <% @questions.each do |q| %>
        <table>
          <tr>
            <th>Question:</th>
            <td><%= q.question %></td>
          </tr>
          <tr>
            <th>Answer:</th>
            <td> <%= text_field_tag "answers[#{q.id}]" %> </td>
          </tr>
        </table>
      <% end %>
      <% if !@questions.blank? %>
        <%= form.submit "Check your answers" %>
      <% end %>
    <% end %>
  </div>

  <% if current_user_admin? %>
    <%= link_to "Add question", new_escape_game_question_path(@escape_game), class: "button"%>
  <% end %>
</section>

<br>

<% if current_user_admin? %>
  <section class="admin">
    <%= link_to "Edit", edit_escape_game_path(@escape_game), class: "button"%>
    <%= link_to "Delete", escape_game_path(@escape_game), class: "button",
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
  </section>
<% end %>
