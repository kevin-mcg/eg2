<section>
  <div>
    <h1><%= @escape_game.title %></h1>
    <p>
      <%= @escape_game.description %>
    </p>
    <table>
      <tr>
        <th>Difficulty:</th>
        <td><%= @escape_game.difficulty %></td>
      </tr>
    </table>
  </div>
</section>

<br>

<section>
  <div>
    <%= form_with(model: @question) do |form| %>
      <h1>Questions</h1>
      <% @questions.each_with_index do |q, i| %>
        <table>
          <tr>
            <th>Question:</th>
            <td><%= q.question %></td>
          </tr>
          <tr>
            <th>Answer:</th>
            <td>
              <%= form.text_field "user_answer_" + "#{i+1}" %>
            </td>
          </tr>
        </table>
      <% end %>
      <%= form.submit "Check your answers" %>
    <% end %>
  </div>

  <%= link_to "Add question", new_escape_game_question_path(@escape_game), class: "button"%>
</section>

<br>

<section>
  <%= link_to "Edit", edit_escape_game_path(@escape_game), class: "button"%>
  <%= link_to "Delete", escape_game_path(@escape_game), class: "button",
              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
</section>