<h1>Editing: <%= @escape_game.title %></h1>

<%= form_with(model: @escape_game) do |eg| %>
  <%= eg.label :title %>
  <br>
  <%= eg.text_field :title %>
  <br>
  
  <%= eg.label :description %>
  <br>
  <%= eg.text_area :description, rows: 7 %>
  <br>

  <%= eg.label :difficulty %>
  <br>
  <%= eg.text_field :difficulty %>
  <br>
  <br>

  <%= eg.submit %>
<% end %>