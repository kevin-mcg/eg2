<h1>Editing: <%= link_to @escape_game.title, @escape_game %> questions</h1>

<%= form_with(model: @question, method: :patch) do |form| %>
  <% @questions.each do |q| %>
    <%= form.label :question %>
    <br>
    <%= form.text_area :question, value: q.question %>
    <br>
    
    <%= form.label :answer %>
    <br>
    <%= form.text_field :answer, value: q.answer %>
    <br>    
  <% end %>

  <%= form.submit "Update questions" %>
<% end %>
