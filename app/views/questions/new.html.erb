<h1>Create a new question for the escape game: <%= @escape_game.title %></h1>

<%= form_with(model: [@escape_game, @question]) do |q| %>
  <%= q.label :question %>
  <br>
  <%= q.text_area :question %>
  <br>
  
  <%= q.label :answer %>
  <br>
  <%= q.text_field :answer %>
  <br>
  
  <%= q.submit %>
<% end %>

